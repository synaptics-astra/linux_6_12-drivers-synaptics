GCC_MINOR_VERSION := $(shell echo $(GCC_VERSION_FULL) | cut -d '.' -f 2)
GCC_MAJOR_MINOR_NUM := $(shell echo $(GCC_MAJOR_VERSION)*10 + $(GCC_MINOR_VERSION) | bc)

ifeq ($(shell [ $(GCC_MAJOR_MINOR_NUM) -ge 46 ]), 0)
KBUILD_CFLAGS += -Wno-macro-redefined -Wno-typedef-redefinition
